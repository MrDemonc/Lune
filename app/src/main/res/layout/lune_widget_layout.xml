<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <!-- Huge Album Cover Art (Left Side - Fills height matching iOS Standby) -->
        <RelativeLayout
            android:id="@+id/cover_container"
            android:layout_width="136dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="14dp"
            android:background="@drawable/widget_cover_shape"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/widget_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground" />
        </RelativeLayout>

        <!-- Right Side Container: Centered Title, Artist & Controls (iOS Standby style) -->
        <RelativeLayout
            android:id="@+id/right_side_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- Output Device Badge (Top Right Corner) -->
            <LinearLayout
                android:id="@+id/widget_output_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:background="@drawable/widget_pill_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:paddingStart="7dp"
                android:paddingEnd="9dp">

                <ImageView
                    android:id="@+id/widget_output_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_speaker" />

                <TextView
                    android:id="@+id/widget_output_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Speaker"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Main Content Area: Centered Title, Artist, and Controls -->
            <LinearLayout
                android:id="@+id/right_center_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Song Title (Centered) -->
                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Song Title"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:gravity="center_horizontal" />

                <!-- Artist Name (Centered) -->
                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Artist Name"
                    android:textColor="#D0D0D0"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:gravity="center_horizontal" />

                <!-- Centered Controls Row (Previous, Play/Pause, Next - Borderless) -->
                <LinearLayout
                    android:id="@+id/widget_controls_row"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/widget_prev"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_widget_prev"
                        android:tint="@android:color/white"
                        android:contentDescription="Previous" />

                    <ImageButton
                        android:id="@+id/widget_play_pause"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_widget_play"
                        android:tint="@android:color/white"
                        android:contentDescription="Play/Pause" />

                    <ImageButton
                        android:id="@+id/widget_next"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_widget_next"
                        android:tint="@android:color/white"
                        android:contentDescription="Next" />
                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>
